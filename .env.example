# 控制台登录动态验证码密钥 (TOTP Secret Generator)
KB_TOTP_SECRET=
# JWT 签名密钥，建议 32 字节以上随机值 (openssl rand -base64 32)
KB_JWT_SECRET=

# 微信小程序 AppID
KB_WCMP_APPID=
# 微信小程序 AppSecret
KB_WCMP_SECRET=
# 订阅消息模板 ID
KB_WCMP_TEMPLATE_ID=

# 可选：反馈提交后触发的 Webhook 模板，支持 <contact>、<content> 占位符
# KB_FEEDBACK_HOOK=

# 可选：docker compose 映射到宿主机的端口，容器内固定 3000
# PORT=3000
